// ============================================  
// EL ÚLTIMO TREN AL EDÉN  
// Juego 2D: plataformas, física, niveles  
// ============================================  

const canvas = document.getElementById('gameCanvas');  
const ctx = canvas.getContext('2d');  
const W = 960, H = 540;  
canvas.width = W;  
canvas.height = H;  

// ---- ENTIDADES Y ESTADO GLOBAL ----  
let gameState = 'title'; // title | playing | won  
let currentLevel = 0;  
let keys = {};  
let particles = [];  
let screenShake = 0;  
let ashParticles = [];  
let fireflies = [];  
let time = 0;  

// ---- CONFIGURACIÓN DEL JUGADOR ----  
const player = {  
    x: 50, y: 400, w: 32, h: 44,  
    vx: 0, vy: 0,  
    speed: 220,  
    jumpForce: -560,  
    grounded: false,  
    facing: 1, // 1=derecha, -1=izquierda  
    onTrain: false  
};  

const GRAVITY = 1400;  
const COLORS = {  
    wasteland: { bg: '#14141f', ground: '#1e1e2e', plat: '#2a2a3e', accent: '#4a4a6a' },  
    paradise:  { bg: '#87CEEB', ground: '#3a7a3a', plat: '#5a9a4a', accent: '#7fc77f' }  
};  

// ---- DEFINICIÓN DE NIVELES ----  
// Cada nivel: array de plataformas [x, y, w, h, tipo]  
// tipo: 'ground' (suelo sólido), plat (plataforma), hazard (peligro)  
// + objetivo (posición de llegada)  
const LEVELS = [  
    // NIVEL 1 - "Las Ruinas" (introducción)  
    {  
        name: "Nivel 1",  
        subtitle: "Las Ruinas Silenciosas",  
        theme: 'wasteland',  
        platforms: [  
            [0, 480, 200, 60, 'ground'],  
            [250, 430, 100, 20, 'plat'],  
            [390, 360, 120, 20, 'plat'],  
            [560, 430, 100, 20, 'plat'],  
            [700, 360, 160, 20, 'plat'],  
            [200, 300, 80, 20, 'plat'],  
            [0, 260, 200, 60, 'ground'],  
            [900, 480, 60, 60, 'ground'] // meta temporal  
        ],  
        spikes: [ {x: 590, y: 450, w: 30, h: 20} ],  
        playerStart: {x: 50, y: 400},  
        objective: { x: 910, y: 430, w: 40, h: 40, type: 'checkpoint' },  
        goalText: "Encuentra la salida de las ruinas"  
    },  
    // NIVEL 2 - "El Puente Colgante"  
    {  
        name: "Nivel 2",  
        subtitle: "El Abismo de Concreto",  
        theme: 'wasteland',  
        platforms: [  
            [0, 480, 150, 60, 'ground'],  
            [180, 400, 80, 15, 'plat'],  
            [300, 340, 90, 15, 'plat'],  
            [430, 400, 60, 15, 'plat'],  
            [540, 480, 200, 60, 'ground'],  
            [790, 380, 70, 15, 'plat'],  
            [900, 300, 100, 15, 'plat'],  
            [850, 220, 60, 15, 'plat'],  
            [600, 220, 80, 15, 'plat'],  
            [450, 160, 60, 15, 'plat'],  
            [250, 200, 100, 15, 'plat'],  
            [100, 160, 80, 15, 'plat'],  
            [0, 100, 120, 60, 'ground']  
        ],  
        spikes: [ {x: 210, y: 420, w: 30, h: 20}, {x: 350, y: 420, w: 30, h: 20} ],  
        playerStart: {x: 30, y: 400},  
        objective: { x: 30, y: 50, w: 60, h: 40, type: 'exit' },  
        goalText: "Escala el abismo del concreto"  
    },  
    // NIVEL 3 - "El Andén de Cenizas"  
    {  
        name: "Nivel 3",  
        subtitle: "El Andén de Cenizas",  
        theme: 'wasteland',  
        platforms: [  
            [0, 480, 300, 60, 'ground'],  
            [280, 420, 140, 20, 'ground'],  // plataforma larga  
            [450, 480, 200, 60, 'ground'],  
            [640, 420, 80, 20, 'plat'],  
            [760, 480, 200, 60, 'ground'],  
            [900, 400, 60, 20, 'plat'],  
            [850, 320, 100, 20, 'plat'],  
            [700, 260, 120, 60, 'ground'],   // zona alta  
            [500, 200, 80, 20, 'plat'],  
            [420, 140, 100, 20, 'plat'],  
            [600, 100, 200, 60, 'ground']   // plataforma del tren  
        ],  
        spikes: [  
            {x: 350, y: 440, w: 30, h: 20},  
            {x: 530, y: 440, w: 30, h: 20},  
            {x: 800, y: 440, w: 30, h: 20}  
        ],  
        playerStart: {x: 50, y: 400},  
        // El tren está en la plataforma alta  
        train: { x: 620, y: 60, w: 160, h: 60 },  
        objective: { x: 660, y: 60, w: 80, h: 50, type: 'train' },  
        goalText: "Alcanza el tren. Ella te espera."  
    }  
];  

// ---- NIVEL FINAL: "EL EDÉN" ----  
const PARADISE = {  
    name: "El Edén",  
    theme: 'paradise',  
    platforms: [  
        [0, 480, 960, 60, 'ground'],  
        [100, 400, 120, 15, 'plat'],  
        [300, 360, 90, 15, 'plat'],  
        [500, 350, 100, 15, 'plat'],  
        [700, 390, 120, 15, 'plat'],  
        [400, 280, 70, 15, 'plat'],  
        [200, 240, 80, 15, 'plat'],  
        [600, 230, 60, 15, 'plat']  
    ],  
    playerStart: {x: 50, y: 400},  
    // La amada (NPC) al final  
    lovedOne: { x: 760, y: 340, w: 32, h: 44 },  
    objective: { x: 760, y: 340, w: 40, h: 40, type: 'loved_one' },  
    goalText: "Encuéntrala. Está esperando."  
};  

// ---- MOSTRAR HUD ----  
function updateHUD() {  
    const hud = document.getElementById('hud');  
    let txt = '';  
    if (gameState === 'playing') {  
        const lvl = currentLevel === LEVELS.length ? PARADISE : LEVELS[currentLevel];  
        const isTrained = currentLevel === LEVELS.length;  
        const indicator = isTrained ? '🌸' : '🚂';  
        txt = `${indicator} ${lvl.name} — ${lvl.subtitle}<br>`;  
        txt += `<span style="opacity:0.6;">◈ ${lvl.goalText}</span><br>`;  
        if (lvl.theme === 'wasteland') {  
            txt += `<span style="color:#8a8a9a; font-size:12px;">« Las cenizas recuerdan. Pero ella espera. »</span>`;  
        } else {  
            txt += `<span style="color:#8ade8a; font-size:12px;">« La luz regresa cuando la encuentras. »</span>`;  
        }  
    }  
    hud.innerHTML = txt;  
}  

// ---- DETECCIÓN DE COLISIONES ----  
function rectCollide(a, b) {  
    return a.x < b.x + b.w && a.x + a.w > b.x &&  
           a.y < b.y + b.h && a.y + a.h > b.y;  
}  

function getActiveLevel() {  
    if (currentLevel >= LEVELS.length) return PARADISE;  
    return LEVELS[currentLevel];  
}  

// ---- ACTUALIZAR JUGADOR ----  
function updatePlayer(dt) {  
    // Movimiento horizontal  
    let moveDir = 0;  
    if (keys['ArrowLeft'] || keys['KeyA']) moveDir -= 1;  
    if (keys['ArrowRight'] || keys['KeyD']) moveDir += 1;  
    player.vx = moveDir * player.speed;  

    // Gravedad  
    player.vy += GRAVITY * dt;  
    if (player.vy > 1000) player.vy = 1000;  

    // Aplicar movimiento  
    player.x += player.vx * dt;  
    player.y += player.vy * dt;  

    // Colisiones — mover en X  
    player.grounded = false;  
    const level = getActiveLevel();  
    for (const p of level.platforms) {  
        const plat = { x: p[0], y: p[1], w: p[2], h: p[3] };  
        if (player.vx > 0 && rectCollide(player, plat) && player.x < plat.x) {  
            player.x = plat.x - player.w;  
        } else if (player.vx < 0 && rectCollide(player, plat) && player.x > plat.x) {  
            player.x = plat.x + plat.w;  
        }  
    }  

    // Colisiones — mover en Y  
    for (const p of level.platforms) {  
        const plat = { x: p[0], y: p[1], w: p[2], h: p[3] };  
        // Aterrizar sobre la plataforma (desde arriba)  
        if (player.vy > 0 && rectCollide(player, plat) &&   
            player.y + player.h < plat.y + plat.h &&   
            player.y + player.h > plat.y - 20) {  
            player.y = plat.y - player.h;  
            player.vy = 0;  
            player.grounded = true;  
        }  
        // Golpear cabeza (desde abajo)  
        else if (player.vy < 0 && rectCollide(player, plat) &&  
                 player.y > plat.y && player.y - player.h < plat.y + plat.h) {  
            player.y = plat.y + plat.h;  
            player.vy = 0;  
        }  
    }  

    // Límites del mundo  
    if (player.x < 0) { player.x = 0; player.vx = 0; }  
    if (player.x > W - player.w) { player.x = W - player.w; }  

    // Caída al vacío (muerte por caída)  
    if (player.y > H + 100) {  
        // Restablecer al inicio del nivel actual  
        resetToCheckpoint();  
    }  

    // Colisión con pinchos  
    for (const s of level.spikes || []) {  
        const spike = { x: s.x, y: s.y, w: s.w, h: s.h };  
        if (rectCollide(player, spike)) {  
            resetToCheckpoint();  
            return;  
        }  
    }  

    // Facing  
    if (moveDir !== 0) player.facing = moveDir;  
}  

function resetToCheckpoint() {  
    const level = getActiveLevel();  
    player.x = level.playerStart.x;  
    player.y = level.playerStart.y;  
    player.vx = 0; player.vy = 0;  
    screenShake = 0.5;  
    spawnDust(player.x + player.w/2, player.y + player.h);  
}  

// ---- SALTO ----  
function handleJump() {  
    if (player.grounded) {  
        player.vy = player.jumpForce;  
        player.grounded = false;  
        spawnDust(player.x + player.w/2, player.y + player.h);  
    }  
}  

// ---- INTERACCIÓN (tecla E) ----  
function handleInteract() {  
    const level = getActiveLevel();  
    const obj = level.objective;  
    const objRect = { x: obj.x, y: obj.y, w: obj.w, h: obj.h };  
    
    // Si es el tren  
    if (obj.type === 'train') {  
        // Solo activar si el jugador está cerca y sobre la plataforma del tren  
        if (rectCollide(player, objRect)) {  
            player.onTrain = true;  
            boardTrain();  
        }  
    }   
    // Si es la amada (nivel paradisíaco)  
    else if (obj.type === 'loved_one') {  
        if (rectCollide(player, objRect) || player.y + player.h > level.lovedOne.y) {  
            winGame();  
        }  
    }  
    // Otras checkpoints (niveles normales)  
    else {  
        if (rectCollide(player, objRect)) {  
            advanceLevel();  
        }  
    }  
}  

// ---- SUBIR AL TREN ----  
function boardTrain() {  
    // Efecto dramático  
    window.levelTransition = 'toParadise';  
    spawnTrainEffects();  
    
    setTimeout(() => {  
        currentLevel = LEVELS.length; // Ir al Edén  
        const level = getActiveLevel();  
        player.x = level.playerStart.x;  
        player.y = level.playerStart.y;  
        player.vx = 0; player.vy = 0;  
        player.onTrain = false;  
        window.levelTransition = null;  
        updateHUD();  
        // Generar luciérnagas  
        for (let i = 0; i < 30; i++) {  
            fireflies.push({  
                x: Math.random() * W,  
                y: Math.random() * H,  
                vx: (Math.random() - 0.5) * 30,  
                vy: (Math.random() - 0.5) * 30,  
                r: Math.random() * 2 + 1,  
                pulse: Math.random() * Math.PI * 2  
            });  
        }  
    }, 1500);  
}  

// ---- AVANZAR NIVEL NORMAL ----  
function advanceLevel() {  
    if (currentLevel < LEVELS.length - 1) {  
        currentLevel++;  
        const level = getActiveLevel();  
        player.x = level.playerStart.x;  
        player.y = level.playerStart.y;  
        player.vx = 0; player.vy = 0;  
        updateHUD();  
        spawnDust(player.x, player.y + player.h);  
    } else {  
        // Último nivel normal, esperar al tren  
        const level = getActiveLevel();  
        if (rectCollide(player, {x: level.train.x, y: level.train.y, w: level.train.w, h: level.train.h})) {  
            boardTrain();  
        }  
    }  
}  

// ---- VICTORIA ----  
function winGame() {  
    gameState = 'won';  
    document.getElementById('win-screen').style.display = 'flex';  
    document.getElementById('hud').innerHTML = '';  
    spawnCelebration();  
}  

// ---- PARTÍCULAS ----  
function spawnDust(x, y) {  
    for (let i = 0; i < 8; i++) {  
        particles.push({  
            x, y,  
            vx: (Math.random() - 0.5) * 120,  
            vy: -Math.random() * 100,  
            life: 0.5,  
            maxLife: 0.5,  
            size: Math.random() * 4 + 2,  
            color: '#8a8a9a'  
        });  
    }  
}  

function spawnTrainEffects() {  
    for (let i = 0; i < 40; i++) {  
        particles.push({  
            x: 660 + (Math.random() - 0.5) * 100,  
            y: 60 + (Math.random() - 0.5) * 60,  
            vx: (Math.random() - 0.5) * 300,  
            vy: -Math.random() * 100,  
            life: 2,  
            maxLife: 2,  
            size: Math.random() * 8 + 2,  
            color: '#ffd580'  
        });  
    }  
    screenShake = 1;  
}  

function spawnCelebration() {  
    for (let i = 0; i < 60; i++) {  
        particles.push({  
            x: W/2 + (Math.random() - 0.5) * 400,  
            y: H/2 + (Math.random() - 0.5) * 200,  
            vx: (Math.random() - 0.5) * 200,  
            vy: -Math.random() * 300,  
            life: 3,  
            maxLife: 3,  
            size: Math.random() * 5 + 2,  
            color: ['#ffd580', '#ff8a8a', '#8ade8a', '#8abaff'][Math.floor(Math.random()*4)]  
        });  
    }  
}  

// ---- CENIZAS CAYENDO (efecto post-apocalíptico) ----  
function initAsh() {  
    ashParticles = [];  
    for (let i = 0; i < 60; i++) {  
        ashParticles.push({  
            x: Math.random() * W,  
            y: Math.random() * H,  
            speed: 15 + Math.random() * 25,  
            drift: (Math.random() - 0.5) * 20,  
            size: 1 + Math.random() * 2,  
            opacity: 0.1 + Math.random() * 0.3  
        });  
    }  
}  

function updateAsh(dt) {  
    for (const a of ashParticles) {  
        a.y += a.speed * dt;  
        a.x += a.drift * dt;  
        if (a.y > H) { a.y = -5; a.x = Math.random() * W; }  
        if (a.x < 0) a.x = W;  
        if (a.x > W) a.x = 0;  
    }  
}  

function drawAsh() {  
    ctx.fillStyle = 'rgba(200,200,220,0.5)';  
    for (const a of ashParticles) {  
        ctx.globalAlpha = a.opacity;  
        ctx.fillRect(a.x, a.y, a.size, a.size);  
    }  
    ctx.globalAlpha = 1;  
}  

function updateFireflies(dt) {  
    for (const f of fireflies) {  
        f.x += f.vx * dt;  
        f.y += f.vy * dt;  
        f.pulse += dt * 3;  
        if (f.x < 0 || f.x > W) f.vx *= -1;  
        if (f.y < 0 || f.y > H) f.vy *= -1;  
    }  
}  

function drawFireflies() {  
    for (const f of fireflies) {  
        const alpha = 0.3 + 0.7 * Math.sin(f.pulse);  
        ctx.fillStyle = `rgba(200, 255, 180, ${alpha * 0.8})`;  
        ctx.beginPath();  
        ctx.arc(f.x, f.y, f.r * (1 + Math.sin(f.pulse) * 0.3), 0, Math.PI * 2);  
        ctx.fill();  
    }  
}  

// ---- DIBUJO ----  
function drawBackground(level) {  
    const theme = level.theme;  
    if (theme === 'wasteland') {  
        // Cielo apocalíptico  
        const grad = ctx.createLinearGradient(0, 0, 0, H);  
        grad.addColorStop(0, '#0a0a15');  
        grad.addColorStop(0.5, '#1a1a2e');  
        grad.addColorStop(1, '#2a1a1a');  
        ctx.fillStyle = grad;  
        ctx.fillRect(0, 0, W, H);  

        // Silueta de edificios caídos  
        ctx.fillStyle = 'rgba(20,20,35,0.8)';  
        for (let i = 0; i < 8; i++) {  
            const bx = i * 130 - 20;  
            const bw = 80 + Math.sin(i) * 30;  
            const bh = 100 + Math.random() * 150;  
            ctx.fillRect(bx, H - 100 - bh * 0.5, bw, bh + 100);  
        }  
        // Sol enfermo (opcional)  
        ctx.fillStyle = 'rgba(200,100,80,0.15)';  
        ctx.beginPath();  
        ctx.arc(W*0.7, 80, 40, 0, Math.PI*2);  
        ctx.fill();  
    } else {  
        // Cielo paradisíaco  
        const grad = ctx.createLinearGradient(0, 0, 0, H);  
        grad.addColorStop(0, '#4a9aca');  
        grad.addColorStop(0.6, '#7ec8e3');  
        grad.addColorStop(1, '#8ade8a');  
        ctx.fillStyle = grad;  
        ctx.fillRect(0, 0, W, H);  

        // Nubes suaves  
        ctx.fillStyle = 'rgba(255,255,255,0.6)';  
        for (let i = 0; i < 5; i++) {  
            const cx = 100 + i * 170;  
            const cy = 50 + Math.sin(i * 1.3) * 30;  
            ctx.beginPath();  
            ctx.arc(cx, cy, 40, 0, Math.PI*2);  
            ctx.arc(cx+30, cy-10, 30, 0, Math.PI*2);  
            ctx.arc(cx+60, cy, 35, 0, Math.PI*2);  
            ctx.fill();  
        }  
        // Colinas  
        ctx.fillStyle = '#3a7a3a';  
        ctx.beginPath();  
        ctx.ellipse(200, H, 300, 150, 0, 0, Math.PI*2);  
        ctx.fill();  
        ctx.beginPath();  
        ctx.ellipse(700, H+20, 350, 180, 0, 0, Math.PI*2);  
        ctx.fill();  
    }  
}  

function drawPlatform(ctx, x, y, w, h, theme) {  
    if (theme === 'wasteland') {  
        ctx.fillStyle = COLORS.wasteland.plat;  
        ctx.fillRect(x, y, w, h);  
        ctx.fillStyle = 'rgba(0,0,0,0.3)';  
        ctx.fillRect(x, y + h - 6, w, 6);  
        // Grietas  
        ctx.strokeStyle = 'rgba(0,0,0,0.3)';  
        ctx.lineWidth = 1;  
        for (let i = 0; i < Math.floor(w/30); i++) {  
            ctx.beginPath();  
            ctx.moveTo(x + i*30, y + h);  
            ctx.lineTo(x + i*30 + 10, y + h - 5);  
            ctx.stroke();  
        }  
    } else {  
        ctx.fillStyle = COLORS.paradise.plat;  
        ctx.fillRect(x, y, w, h);  
        ctx.fillStyle = 'rgba(255,255,255,0.2)';  
        ctx.fillRect(x, y, w, 4);  
        // Flores decorativas  
        ctx.fillStyle = '#ff8a9a';  
        for (let i = 0; i < Math.floor(w/40); i++) {  
            ctx.beginPath();  
            ctx.arc(x + i*40 + 10, y + 8, 3, 0, Math.PI*2);  
            ctx.fill();  
        }  
    }  
}  

